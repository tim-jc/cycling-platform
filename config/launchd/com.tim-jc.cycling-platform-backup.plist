<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tim-jc.cycling-platform-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/scripts/run_backup_workflow.sh</string>
    <string>backup</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/backup-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/backup-launchd.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
