# Event-only, multi-day example. Rename this file to <event_key>.yml.
event_key: example-trip
event_name: Example cycling trip
start_date: "2027-05-10"
end_date: "2027-05-17"
event_type: mountain cycling holiday
coaching_intent: plan_around
overall_objective: Enjoy the riding while managing fatigue across the trip.
location: Example Island
context: Warm conditions and sustained climbing may affect recovery.
notes: null
is_cancelled: false
stages: []

